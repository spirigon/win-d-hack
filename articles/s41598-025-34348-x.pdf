              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://ns.adobe.com/xap/1.0/t/pg/"
